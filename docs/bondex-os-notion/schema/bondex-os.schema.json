{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BondEx OS - Notion machine-readable schema",
  "description": "Claude Code automation reads this file as the source of truth for property names, types, and select options. Fill database_id after building the databases in Notion. Do NOT rename properties once live.",
  "version": "1.0.0",
  "notion_api_version": "2022-06-28",
  "conventions": {
    "money_unit": "JPY",
    "weight_unit": "kg",
    "count_type": "integer",
    "title_is_natural_key": {
      "dmc": "会社名",
      "travelers": "旅行ID",
      "meetings": "タイトル",
      "poc": "名称",
      "decision_log": "タイトル",
      "documents": "タイトル",
      "stakeholders": "名称"
    },
    "rules": [
      "作成前にTitleで重複チェックする",
      "Select/Multiは許可値のみ。無い区分は『その他』",
      "AI由来データは 生成元=Claude Code / 出典URL / 情報取得日 を記録",
      "送信・外部共有は人間承認後"
    ]
  },
  "databases": {
    "dmc": {
      "display_name": "DMC / ランドオペレーター",
      "database_id": "",
      "title_property": "会社名",
      "properties": {
        "会社名": { "type": "title" },
        "優先順位": { "type": "select", "options": ["S", "A", "B"] },
        "担当者": { "type": "rich_text" },
        "役職": { "type": "rich_text" },
        "メール": { "type": "email" },
        "電話": { "type": "phone_number" },
        "所在地": { "type": "rich_text" },
        "国": { "type": "select", "options": ["日本", "その他"] },
        "URL": { "type": "url" },
        "問い合わせURL": { "type": "url" },
        "北海道案件": { "type": "checkbox" },
        "団体旅行": { "type": "checkbox" },
        "FIT": { "type": "checkbox" },
        "添乗員同行": { "type": "checkbox" },
        "得意国": { "type": "multi_select", "options": ["中国", "台湾", "香港", "韓国", "タイ", "シンガポール", "マレーシア", "インドネシア", "ベトナム", "米国", "豪州", "英国", "仏", "独", "その他"] },
        "得意地域": { "type": "multi_select", "options": ["北海道", "東北", "関東", "中部", "関西", "中国地方", "四国", "九州", "沖縄", "全国"] },
        "PoC候補": { "type": "checkbox" },
        "営業ステータス": { "type": "select", "options": ["未着手", "リサーチ済", "一次接触", "商談中", "PoC調整中", "PoC実施中", "成約", "保留", "見送り"] },
        "最終接触日": { "type": "date" },
        "次回アクション": { "type": "rich_text" },
        "次回アクション期日": { "type": "date" },
        "要フォロー": { "type": "formula" },
        "Meetings": { "type": "relation", "related": "meetings" },
        "Documents": { "type": "relation", "related": "documents" },
        "PoC": { "type": "relation", "related": "poc" },
        "Travelers": { "type": "relation", "related": "travelers" },
        "Stakeholders": { "type": "relation", "related": "stakeholders" },
        "Decision Log": { "type": "relation", "related": "decision_log" },
        "Meeting数": { "type": "rollup" },
        "最新Meeting日": { "type": "rollup" },
        "PoC数": { "type": "rollup" },
        "累計配送件数": { "type": "rollup" },
        "出典URL": { "type": "url" },
        "情報取得日": { "type": "date" },
        "メモ": { "type": "rich_text" }
      }
    },
    "meetings": {
      "display_name": "Meetings",
      "database_id": "",
      "title_property": "タイトル",
      "properties": {
        "タイトル": { "type": "title" },
        "日時": { "type": "date", "include_time": true },
        "会社": { "type": "relation", "related": "dmc" },
        "関連先(Stakeholder)": { "type": "relation", "related": "stakeholders" },
        "関連PoC": { "type": "relation", "related": "poc" },
        "参加者(先方)": { "type": "rich_text" },
        "参加者(BondEx)": { "type": "people" },
        "議事録": { "type": "rich_text" },
        "課題": { "type": "rich_text" },
        "宿題": { "type": "rich_text" },
        "Next Action": { "type": "rich_text" },
        "Next Action期日": { "type": "date" },
        "PoC化可能性": { "type": "select", "options": ["高", "中", "低", "なし"] },
        "添付資料": { "type": "relation", "related": "documents" },
        "ファイル": { "type": "files" },
        "Fathom URL": { "type": "url" },
        "要約ステータス": { "type": "select", "options": ["未要約", "AI要約済", "確認済"] }
      }
    },
    "travelers": {
      "display_name": "Travelers",
      "database_id": "",
      "title_property": "旅行ID",
      "properties": {
        "旅行ID": { "type": "title" },
        "ランドオペ": { "type": "relation", "related": "dmc" },
        "PoC": { "type": "relation", "related": "poc" },
        "ツアー名": { "type": "rich_text" },
        "旅行開始日": { "type": "date" },
        "旅行終了日": { "type": "date" },
        "旅行日数": { "type": "formula" },
        "出国空港": { "type": "select", "options": ["新千歳", "羽田", "成田", "中部", "関西", "福岡", "那覇", "その他"] },
        "帰国空港": { "type": "select", "options": ["新千歳", "羽田", "成田", "中部", "関西", "福岡", "那覇", "その他"] },
        "利用航空会社": { "type": "multi_select", "options": ["JAL", "ANA", "Peach", "Jetstar", "中国国際", "中華航空", "キャセイ", "大韓", "その他"] },
        "旅行人数": { "type": "number" },
        "国籍": { "type": "select", "options": ["中国", "台湾", "香港", "韓国", "タイ", "シンガポール", "マレーシア", "米国", "豪州", "英国", "その他"] },
        "添乗員": { "type": "checkbox" },
        "添乗員名": { "type": "rich_text" },
        "利用ホテル": { "type": "relation", "related": "stakeholders" },
        "観光地": { "type": "multi_select", "options": ["札幌", "小樽", "富良野", "函館", "ニセコ", "旭川", "知床", "その他"] },
        "購入店舗": { "type": "relation", "related": "stakeholders" },
        "配送件数": { "type": "number" },
        "配送商品数": { "type": "number" },
        "配送重量": { "type": "number", "unit": "kg" },
        "配送金額": { "type": "number", "unit": "JPY" },
        "受取場所": { "type": "rich_text" },
        "受取日時": { "type": "date", "include_time": true },
        "トラブル有無": { "type": "select", "options": ["なし", "軽微", "重大"] },
        "トラブル内容": { "type": "rich_text" },
        "一人あたり配送金額": { "type": "formula" },
        "一件あたり重量": { "type": "formula" }
      }
    },
    "stakeholders": {
      "display_name": "Stakeholders",
      "database_id": "",
      "title_property": "名称",
      "properties": {
        "名称": { "type": "title" },
        "カテゴリ": { "type": "select", "options": ["空港", "ホテル", "観光協会", "物流会社", "バス会社", "お土産店", "ロッカー事業者", "自治体", "その他"] },
        "担当者": { "type": "rich_text" },
        "役職": { "type": "rich_text" },
        "電話": { "type": "phone_number" },
        "メール": { "type": "email" },
        "所在地": { "type": "rich_text" },
        "地域": { "type": "select", "options": ["北海道", "東北", "関東", "中部", "関西", "中国地方", "四国", "九州", "沖縄"] },
        "URL": { "type": "url" },
        "優先度": { "type": "select", "options": ["S", "A", "B"] },
        "ステータス": { "type": "select", "options": ["未接触", "接触済", "連携協議中", "連携中", "見送り"] },
        "関連DMC": { "type": "relation", "related": "dmc" },
        "PoC": { "type": "relation", "related": "poc" },
        "Meetings": { "type": "relation", "related": "meetings" },
        "Documents": { "type": "relation", "related": "documents" },
        "利用実績(Travelers-ホテル)": { "type": "relation", "related": "travelers" },
        "購入実績(Travelers-店舗)": { "type": "relation", "related": "travelers" },
        "備考": { "type": "rich_text" }
      }
    },
    "documents": {
      "display_name": "Documents",
      "database_id": "",
      "title_property": "タイトル",
      "properties": {
        "タイトル": { "type": "title" },
        "種別": { "type": "select", "options": ["提案資料", "契約書", "PoC資料", "プレゼン", "Vision", "Business Model", "Meeting資料", "分析レポート", "その他"] },
        "タグ": { "type": "multi_select", "options": [] },
        "ステータス": { "type": "select", "options": ["ドラフト", "レビュー中", "確定", "アーカイブ"] },
        "作成日": { "type": "date" },
        "版": { "type": "rich_text" },
        "ファイル": { "type": "files" },
        "リンク": { "type": "url" },
        "関連DMC": { "type": "relation", "related": "dmc" },
        "関連Meeting": { "type": "relation", "related": "meetings" },
        "関連PoC": { "type": "relation", "related": "poc" },
        "関連Stakeholder": { "type": "relation", "related": "stakeholders" },
        "関連Decision": { "type": "relation", "related": "decision_log" },
        "作成者": { "type": "people" },
        "生成元": { "type": "select", "options": ["人手", "Claude Code"] }
      }
    },
    "poc": {
      "display_name": "PoC",
      "database_id": "",
      "title_property": "名称",
      "properties": {
        "名称": { "type": "title" },
        "地域": { "type": "select", "options": ["北海道", "東北", "関東", "中部", "関西", "中国地方", "四国", "九州", "沖縄"] },
        "ステータス": { "type": "select", "options": ["構想", "計画中", "準備中", "実施中", "検証中", "完了", "中止"] },
        "開始日": { "type": "date" },
        "終了日": { "type": "date" },
        "期間(日)": { "type": "formula" },
        "参加企業": { "type": "relation", "related": "dmc" },
        "ランドオペ": { "type": "relation", "related": "dmc" },
        "ホテル": { "type": "relation", "related": "stakeholders" },
        "空港": { "type": "relation", "related": "stakeholders" },
        "参加人数(目標)": { "type": "number" },
        "目標配送件数": { "type": "number" },
        "目標売上": { "type": "number", "unit": "JPY" },
        "Travelers": { "type": "relation", "related": "travelers" },
        "実績参加人数": { "type": "rollup" },
        "実績配送件数": { "type": "rollup" },
        "実績配送金額": { "type": "rollup" },
        "利用率": { "type": "formula" },
        "達成率(売上)": { "type": "formula" },
        "課題": { "type": "rich_text" },
        "改善案": { "type": "rich_text" },
        "結果": { "type": "rich_text" },
        "Meetings": { "type": "relation", "related": "meetings" },
        "Documents": { "type": "relation", "related": "documents" },
        "Decision": { "type": "relation", "related": "decision_log" }
      }
    },
    "decision_log": {
      "display_name": "Decision Log",
      "database_id": "",
      "title_property": "タイトル",
      "properties": {
        "タイトル": { "type": "title" },
        "日付": { "type": "date" },
        "カテゴリ": { "type": "select", "options": ["戦略", "営業", "プロダクト", "パートナー", "オペレーション", "資金", "採用", "法務"] },
        "背景": { "type": "rich_text" },
        "選択肢": { "type": "rich_text" },
        "採用理由": { "type": "rich_text" },
        "決定内容": { "type": "rich_text" },
        "結果": { "type": "rich_text" },
        "ステータス": { "type": "select", "options": ["有効", "見直し中", "破棄"] },
        "次回見直し日": { "type": "date" },
        "意思決定者": { "type": "people" },
        "関連DMC": { "type": "relation", "related": "dmc" },
        "関連PoC": { "type": "relation", "related": "poc" },
        "関連Documents": { "type": "relation", "related": "documents" }
      }
    }
  },
  "relations": [
    { "id": "R1", "a": "dmc.Meetings", "b": "meetings.会社" },
    { "id": "R2", "a": "dmc.Documents", "b": "documents.関連DMC" },
    { "id": "R3", "a": "dmc.PoC", "b": "poc.参加企業" },
    { "id": "R4", "a": "dmc.PoC(ランドオペ)", "b": "poc.ランドオペ" },
    { "id": "R5", "a": "dmc.Travelers", "b": "travelers.ランドオペ" },
    { "id": "R6", "a": "dmc.Stakeholders", "b": "stakeholders.関連DMC" },
    { "id": "R7", "a": "dmc.Decision Log", "b": "decision_log.関連DMC" },
    { "id": "R8", "a": "meetings.関連先(Stakeholder)", "b": "stakeholders.Meetings" },
    { "id": "R9", "a": "meetings.関連PoC", "b": "poc.Meetings" },
    { "id": "R10", "a": "meetings.添付資料", "b": "documents.関連Meeting" },
    { "id": "R11", "a": "travelers.PoC", "b": "poc.Travelers" },
    { "id": "R12", "a": "travelers.利用ホテル", "b": "stakeholders.利用実績(Travelers-ホテル)" },
    { "id": "R13", "a": "travelers.購入店舗", "b": "stakeholders.購入実績(Travelers-店舗)" },
    { "id": "R14", "a": "poc.ホテル/空港", "b": "stakeholders.PoC" },
    { "id": "R15", "a": "stakeholders.Documents", "b": "documents.関連Stakeholder" },
    { "id": "R16", "a": "poc.Documents", "b": "documents.関連PoC" },
    { "id": "R17", "a": "poc.Decision", "b": "decision_log.関連PoC" },
    { "id": "R18", "a": "documents.関連Decision", "b": "decision_log.関連Documents" }
  ],
  "rollups": [
    { "db": "dmc", "name": "Meeting数", "via": "Meetings", "target": "*", "function": "count" },
    { "db": "dmc", "name": "最新Meeting日", "via": "Meetings", "target": "日時", "function": "latest_date" },
    { "db": "dmc", "name": "PoC数", "via": "PoC", "target": "*", "function": "count" },
    { "db": "dmc", "name": "累計配送件数", "via": "Travelers", "target": "配送件数", "function": "sum" },
    { "db": "poc", "name": "実績参加人数", "via": "Travelers", "target": "旅行人数", "function": "sum" },
    { "db": "poc", "name": "実績配送件数", "via": "Travelers", "target": "配送件数", "function": "sum" },
    { "db": "poc", "name": "実績配送金額", "via": "Travelers", "target": "配送金額", "function": "sum" }
  ]
}
